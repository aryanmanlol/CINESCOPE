# .gitignore for CineScope
# These files are excluded from version control

# ── Large data files (track code, not data) ─────────────────────────────────
data/raw/
data/serving/
data/sample/

# ── Hadoop/Hive/HBase runtime data (on Linux filesystem in WSL) ─────────────
# (these live at ~/cinescope-hadoop-tmp etc., not in the project dir)

# ── Python ───────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
setup.log

# ── Reports (generated, not source) ─────────────────────────────────────────
reports/screenshots/
reports/*.csv    # Re-generated by pipeline; commit only empty stubs

# ── Editor files ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── WSL config (has absolute paths, user-specific) ──────────────────────────
.wslconfig
